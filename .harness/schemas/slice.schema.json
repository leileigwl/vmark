{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Concurrent Slice Contract",
  "type": "object",
  "required": [
    "sliceId",
    "changeName",
    "assigneeTier",
    "worktreeBranch",
    "status",
    "retryCount",
    "maxRetries",
    "maxDiffLines",
    "ownedPaths",
    "forbiddenPaths",
    "requiredChecks"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "sliceId": { "type": "string", "minLength": 1 },
    "changeName": { "type": "string", "minLength": 1 },
    "assigneeTier": { "type": "string", "enum": ["small-model", "frontier-model"] },
    "worktreeBranch": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "escalated", "merged", "archived"]
    },
    "retryCount": { "type": "integer", "minimum": 0 },
    "maxRetries": { "type": "integer", "minimum": 1 },
    "maxDiffLines": { "type": "integer", "minimum": 1, "maximum": 300 },
    "ownedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "forbiddenPaths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requiredChecks": {
      "type": "array",
      "items": { "type": "string", "enum": ["L0", "L1", "L2", "L3"] }
    },
    "lastFailureSummary": { "type": ["string", "null"] }
  }
}
