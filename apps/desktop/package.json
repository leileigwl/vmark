{
  "name": "@vcat/desktop",
  "version": "0.1.0",
  "description": "Local-First desktop Markdown writing, image pipeline & multi-platform publisher",
  "author": "leileigwl <leileigwl@github.com>",
  "homepage": "https://github.com/leileigwl/vmark",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "copy-vditor": "node scripts/copy-vditor-assets.mjs",
    "predev": "pnpm run copy-vditor",
    "dev": "electron-vite dev",
    "prebuild": "pnpm run copy-vditor",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:mac": "pnpm run copy-vditor && electron-vite build && electron-builder --mac --publish never",
    "package:win": "pnpm run copy-vditor && electron-vite build && electron-builder --win --publish never",
    "package:linux": "pnpm run copy-vditor && electron-vite build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.vmark.desktop",
    "productName": "Vmark",
    "executableName": "vmark",
    "publish": [],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "executableName": "vmark",
      "maintainer": "leileigwl <leileigwl@github.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "deb": {
      "packageName": "vmark"
    }
  },
  "dependencies": {
    "@vcat/adapters": "workspace:*",
    "@vcat/core": "workspace:*",
    "@vcat/image-pipeline": "workspace:*",
    "@vcat/shared": "workspace:*",
    "docx": "^9.15.4",
    "lucide-react": "^0.468.0",
    "vditor": "^3.10.9"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
